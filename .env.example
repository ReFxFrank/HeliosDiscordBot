# ─────────────────────────────────────────────────────────────────────────────
# ReFx Assistant — environment configuration
#
# Copy this file to `.env` and fill in the values. Never commit `.env`.
# All secrets live here only.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
# development | test | production
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ── Database (PostgreSQL 16) ────────────────────────────────────────────────
# Matches the docker-compose Postgres defaults. PRODUCTION: use a strong random
# password (`openssl rand -hex 24`); in prod the data stores bind to 127.0.0.1.
POSTGRES_USER=refx
POSTGRES_PASSWORD=refx
POSTGRES_DB=refx
POSTGRES_PORT=5432
DATABASE_URL=postgresql://refx:refx@localhost:5432/refx?schema=public

# ── Redis 7 (cache / pub-sub / BullMQ) ──────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
# PRODUCTION: required by docker-compose.prod.yml (`openssl rand -hex 32`).
# REDIS_PASSWORD=

# ── Discord application ──────────────────────────────────────────────────────
# Create the "ReFx Assistant" application at
# https://discord.com/developers/applications. In the Bot tab enable the
# SERVER MEMBERS and MESSAGE CONTENT privileged intents.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Comma-separated Discord user IDs with owner powers (/admin, admin dashboard).
OWNER_IDS=
# Optional: register slash commands into this guild for instant iteration.
# DEV_GUILD_ID=

# ── Dashboard (Auth.js / NextAuth v5) ────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Public URL of the dashboard, e.g. https://bot.refx.gg in production.
AUTH_URL=http://localhost:3000
WEB_PORT=3000
# In the Discord Developer Portal → OAuth2, add this Redirect URL:
#   ${AUTH_URL}/api/auth/callback/discord
# The bot's link buttons (/help, onboarding) point here when set.
# DASHBOARD_URL=http://localhost:3000

# ── FiveM city (refx_whitelist resource) ─────────────────────────────────────
# The whitelist API the game server calls on connect. Unset disables it.
# Generate with: openssl rand -hex 32, and put the same value in the game
# server's `set refx_whitelist_key "..."`.
# FIVEM_API_KEY=
# FIVEM_API_PORT=30125
# FIVEM_API_HOST=0.0.0.0
# The ReFx guild whose roles gate the city (defaults to the first guild with the
# whitelist turned on).
# REFX_GUILD_ID=1005197251225858180

# ── Error tracking (Sentry, optional) ───────────────────────────────────────
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# ── Metrics (optional) ───────────────────────────────────────────────────────
# METRICS_ENABLED=true
# METRICS_PORT=9090

# ── Social alerts (optional) ─────────────────────────────────────────────────
# Twitch live alerts need app credentials; YouTube/Reddit/Bluesky/RSS need none.
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=

# ── Support server (optional) ────────────────────────────────────────────────
# SUPPORT_SERVER_INVITE=https://discord.gg/your-invite

# ── Offsite backups (optional) ──────────────────────────────────────────────
# The backup service keeps nightly dumps on the VPS (BACKUP_RETENTION_DAYS,
# default 14). Fill these in to also push every dump to an S3-compatible bucket
# (Cloudflare R2, Backblaze B2, AWS S3, MinIO).
# BACKUP_S3_BUCKET=refx-bot-backups
# BACKUP_S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# Cloudflare | Backblaze | AWS | Minio | Other (default)
# BACKUP_S3_PROVIDER=Cloudflare
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_S3_PREFIX=refx-bot
# BACKUP_S3_RETENTION_DAYS=30
# BACKUP_S3_REGION=
